# Google service account: share the spreadsheet with this account as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account PEM private key; escaped newlines (\\n) are accepted.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional. If omitted, GOOGLE_PRIVATE_KEY is used to sign tamu_user sessions.
# Rotating the signing key invalidates existing sessions.
SESSION_SECRET=
