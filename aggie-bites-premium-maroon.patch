+
+/* Dialogs, filters, TAMU login and review forms */
+dialog.dialog, dialog.dialog.wide {
+  background: #1d1b25;
+  color: #f8f0f2;
+  border: 1px solid #6e4358;
+  border-radius: 18px;
+  box-shadow: 0 36px 100px #000b;
+}
