+/*
+ * Aggie Bites — Dark & Premium / Maroon
+ * An additive visual layer. All discovery, authentication, map and review
+ * logic stays in the original components. Imported AFTER globals.css.
+ */
+:root {
+  color-scheme: dark;
+  --maroon: #bb5978;
+  --maroon-dark: #8a304c;
+  --ink: #f5f0f0;
+  --muted: #b7aab2;
+  --line: #39343d;
+  --paper: #101116;
+  --green: #c3889c;
+  --premium-surface: #1b1b23;
+  --premium-surface-raised: #24232d;
+  --premium-surface-hover: #302733;
+  --premium-border: #37323d;
+  --premium-soft: #e6b5c5;
+  --premium-highlight: #e8c6b2;
+}
+
+html { background: var(--paper); }
+body {
+  background: radial-gradient(circle at 82% -30%, #49213365, transparent 46%),
+              radial-gradient(circle at 6% 28%, #2c203033, transparent 38%),
+              var(--paper);
+  color: var(--ink);
+  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+::selection { background: #a94b6b; color: #fff; }
+:where(button, input, select, textarea, a):focus-visible {
+  outline: 2px solid var(--premium-soft);
+  outline-offset: 3px;
+}
+:where(input, select, textarea) { accent-color: var(--maroon); }
+:where(input, select, textarea)::placeholder { color: #918691; opacity: 1; }
+:where(select option) { background: #1d1c25; color: var(--ink); }
+:where(*::-webkit-scrollbar) { width: 10px; height: 10px; }
+:where(*::-webkit-scrollbar-thumb) { background: #51404e; border: 2px solid #1b1b23; border-radius: 10px; }
+:where(*::-webkit-scrollbar-track) { background: #17171e; }
+
+/* Fixed navigation and premium editorial heading */
+.header,
+.map-app .header {
+  background: #141319ed;
+  border-bottom: 1px solid #50313f;
+  box-shadow: 0 8px 32px #07060b35;
+  backdrop-filter: blur(20px);
+}
+.map-app .header-inner { gap: 34px; }
+.brand, .map-app .brand { color: #fff7f4; font-weight: 760; letter-spacing: -1.25px; }
+.brand>span:last-child>span { color: #efcad6; }
+.brand b { color: #d98aa5; }
+.brand-icon, .map-app .brand-icon {
+  background: linear-gradient(145deg, #aa4766, #67243c);
+  color: #fff3f5;
+  border: 1px solid #ca7b9455;
+  border-radius: 12px;
+  box-shadow: 0 5px 18px #65253d4d;
+}
+.header nav>button, .map-app .header nav>button { color: #aea3ad; letter-spacing: .005em; }
+.header nav>button:hover, .map-app .header nav>button:hover,
+.header nav>button.active, .map-app .header nav>button.active { color: #ffe0e9; }
+.header nav>button.active:after { background: #bd607e; height: 2px; }
+.header nav>button>span { color: #f2c3d2; background: #4b2937; }
+.account-button { background: #842e4c; color: #fff; border: 1px solid #b65776; }
+.account-button:hover { background: #a44665; }
+.account-button.signed-in { background: #302431; color: #f4c9d7; }
+.account-initial { background: #583043; color: #ffe7ee; }
+
+.main, .map-main { color: var(--ink); }
+.map-main {
+  background: radial-gradient(circle at 84% 1%, #5b2a4029, transparent 42%);
+}
+h1, .explorer-intro h1, .feature-empty h2,
+.theme-hero h2, .modal-padding>h2, .detail-title h2,
+.theme-heading h2, .my-review-list h2 {
+  font-family: Iowan Old Style, Baskerville, Georgia, "Times New Roman", serif;
+  font-weight: 400;
+  letter-spacing: -1.1px;
+}
+.explorer-intro { position: relative; }
+.explorer-intro>div:first-child::before {
+  content: "DISCOVER COLLEGE STATION";
+  display: block;
+  margin-bottom: 8px;
+  color: #cb88a0;
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: 2.5px;
+}
+.explorer-intro h1 { color: #fff9f7; text-shadow: 0 1px 18px #0006; }
+.explorer-intro p, .intro>div>p:last-child { color: #b8acb5; }
