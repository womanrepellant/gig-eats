+  border: 1px solid #3d3540;
+  background: #211f27;
+  border-radius: 999px;
+}
+.shortcut-row>button:hover, .map-search .shortcut-row>button:hover {
+  background: #322633;
+  border-color: #9e526e;
+  color: #f8d4e1;
+}
+.shortcut-row>button.active, .map-search .shortcut-row>button.active,
+.shortcut-row>button.seasonal, .shortcut-row>button.seasonal.active {
+  background: #52283a;
+  border-color: #9e506e;
+  color: #f8d7e2;
+}
+.map-search .shortcut-row>.clear-inline, .active-filters button { color: #efa5bd; }
+
+/* Consistent raised surfaces and meaningful selection */
+.panel-heading { background: #101116f2; backdrop-filter: blur(8px); }
+.panel-heading h2 { color: #fff4f4; }
+.panel-heading h2>span, .results-toolbar h2>span, .reviews-heading h3>span {
+  background: #422837;
+  color: #f4becf;
+}
+.panel-heading select, .results-controls select { color: #d2b7c7; }
+.results-panel { scrollbar-color: #51404f transparent; }
+.spot-row, .restaurant-card, .theme-card {
