+
+/* Keep accessible spacing and existing small-screen map/list behavior. */
+@media (min-width: 1001px) {
+  .map-workspace { gap: 18px; }
+  .map-main { padding-top: 26px; }
+  .spot-row { padding: 18px 15px; }
+}
+@media (max-width: 760px) {
+  .explorer-intro>div:first-child::before { font-size: 8px; letter-spacing: 1.7px; margin-bottom: 5px; }
+  .map-main { background: #101116; }
+  .map-workspace { gap: 12px; }
+  .map-mode .map-workspace>.spot-map { border-radius: 12px; }
+  .panel-heading { background: #101116f2; }
+  .theme-hero { border-radius: 14px; }
+}
+@media (max-width: 600px) {
+  .header, .map-app .header { background: #141319f5; }
+  .map-app .header-inner { gap: 8px; }
+  .map-main { padding-top: 15px; }
+  .spot-row { border-radius: 12px; }
+  .map-mode .results-panel { border-radius: 12px; }
+  .map-workspace .map-top>span, .map-workspace .map-top>button { background: #201d27ed; }
+  dialog.dialog { border-radius: 14px; }
+  .modal-padding { padding: 27px 22px; }
