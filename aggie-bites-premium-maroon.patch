+  color: #f6f0f2;
+  border: 1px solid #39333e;
+  box-shadow: inset 0 1px #ffffff09, 0 6px 16px #05050925;
+  border-radius: 14px;
+}
+.spot-row:hover, .restaurant-card:hover, .theme-card:hover {
+  background: linear-gradient(150deg, #342532, #25212c 88%);
+  border-color: #8b5269;
+  box-shadow: inset 0 1px #ffffff15, 0 8px 22px #05040740;
