+  border-color: #c07790;
+  box-shadow: 0 0 0 1px #b6638040, 0 8px 24px #0006;
+}
+.spot-type-icon, .spot-type-icon.type-coffee,
+.spot-type-icon.type-seafood {
+  background: #472b3b;
+  color: #f1b6c7;
+  border: 1px solid #704056;
+  border-radius: 12px;
+}
+.spot-type-icon.type-seafood { background: #302e3c; color: #b9a8dc; border-color: #51475f; }
+.spot-type-icon.type-coffee { background: #41302e; color: #ebc3a1; border-color: #694b46; }
+.spot-name, .card-title>button { color: #f9f2f3; font-weight: 670; }
+.spot-name:hover, .card-title>button:hover { color: #ffbecf; }
+.spot-meta, .card-meta, .card-distance, .catalog-note { color: #b6a7b3; }
+.spot-meta>span, .card-meta i { color: #766a78; }
+.spot-rating { color: #b6a8b3; }
+.spot-rating>svg, .spot-rating>strong, .rating { color: #eb9bb2; }
+.spot-row-links>a, .spot-row-links>button, .card-bottom>button { color: #e6a2b8; }
+.spot-row-links>a:hover, .spot-row-links>button:hover { color: #ffe1eb; }
+.row-save { color: #b19aaa; }
+.row-save:hover, .row-save.saved { background: #522c3f; color: #f6b3c9; }
+.card-photo { background: #282630; }
+.card-save { background: #302531e8; color: #f2d5df; }
+.card-save.saved { background: #8b3351; color: #fff; }
+.card-body { color: #f7f0f3; }
+.card-bottom { border-color: #39323d; color: #b3a5b0; }
+.catalog-footer, .main-footer { border-color: #39323d; color: #a99ca7; }
+.catalog-footer>button, .main-footer>button { color: #e5a0b6; }
+.load-more {
+  background: #30202e;
+  border: 1px solid #73415a;
+  color: #f4bbcf;
+  border-radius: 11px;
+}
