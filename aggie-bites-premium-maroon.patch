+
+/* Map tiles retain the existing map engine and click/zoom behavior. */
+.spot-map, .map-workspace>.spot-map {
+  background: #232630;
+  border: 1px solid #4b3b49;
+  border-radius: 16px;
+  box-shadow: inset 0 1px #ffffff12, 0 9px 28px #0004;
+  overflow: hidden;
+}
+.spot-map .tiles img {
+  filter: grayscale(.66) invert(.91) hue-rotate(175deg) brightness(.72) contrast(.9);
+}
+.map-top>span, .map-top>button,
