+.cluster-choices>button { border-color: #433340; }
+.cluster-choices>button:hover { background: #382838; }
+.cluster-choices small { color: #b8a4b1; }
+.cluster-zoom { border-color: #473343; color: #f0a8be; }
+.map-error { background: #402434; color: #ffe6ed; border-color: #94516e; }
+
+/* Buttons and interactive surface states */
+.primary, a.primary {
+  background: linear-gradient(140deg, #9a3b59, #792c47);
+  color: #fff9fa;
+  border: 1px solid #c46b88;
+  box-shadow: inset 0 1px #ffffff16, 0 5px 18px #5a1e3b35;
+  border-radius: 10px;
+}
+.primary:hover, a.primary:hover { background: #ad4c6b; color: #fff; }
